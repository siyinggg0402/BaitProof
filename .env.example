# Copy to .env and fill in. .env is gitignored. NEVER put real keys in this file.

# --- Inference (Nebius Token Factory, OpenAI-compatible) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_LIGHT=             # optional lighter model for cheap stages

# --- Optional verification (review-style web checks; the Wikidata company check needs no key) ---
TAVILY_API_KEY=

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
BAITPROOF_BOT_CONCURRENCY=16   # how many Telegram updates are handled at once (a slow screenshot read no longer blocks other chats)
TELEGRAM_BOT_USERNAME=          # e.g. BaitproofBot: makes "Connect Telegram" one tap (a t.me link that carries the one-time code)
BAITPROOF_URL=                  # public URL of the web app, shown in the bot ("Saved to your records")

# --- App ---
BAITPROOF_DB=baitproof.sqlite   # tactic mastery + abstracted library, NO raw PII
BAITPROOF_MULTIUSER=            # 1 on a public server: one anonymous profile per visitor
BAITPROOF_ADMIN_TOKEN=          # enables /admin (health, metrics, recent checks, feedback)
BAITPROOF_RATE=30               # per-IP requests/min on routes that cost model calls
BAITPROOF_STORE_PREVIEW=1       # redacted 120-char preview in Records (0 = off by default; users can also switch it per profile)

# --- Pipeline limits and switches (defaults are sensible) ---
BAITPROOF_MAX_ROUNDS=3
BAITPROOF_MAX_LLM_CALLS=10
BAITPROOF_MAX_SECONDS=25
BAITPROOF_MAX_TOKENS=2500
BAITPROOF_NET_TOOLS=1           # 0 disables the network tools (RDAP, certificate log, DNS, Wikidata, Tavily) and the daily phishing-list download
BAITPROOF_BLOCKLIST=1           # 0 turns the public phishing-site list off (a local file, refreshed daily from Phishing.Database)
BAITPROOF_CACHE_DIR=data/cache  # where that list is kept
BAITPROOF_FEWSHOT=0             # 1 = retrieve labelled examples into the prompt (see docs/EVALUATION.md: off until measured)
BAITPROOF_FEWSHOT_MODE=balanced # balanced | knn
BAITPROOF_THINKING=0            # 1 re-enables model reasoning mode (about 10x the tokens)

# --- Screenshots, voice notes and links ---
NEBIUS_MODEL_VISION=            # default nvidia/Nemotron-3.5-Super-VL (reads screenshots)
BAITPROOF_VISION=1              # 0 turns screenshot reading off (a screenshot is sent unmodified to the model: names and numbers in it cannot be scrubbed)
BAITPROOF_VISION_LINKS=auto     # auto | always | off: a second, links-only read of a screenshot (auto = only when a short link is present or the read was unsure)
BAITPROOF_STT=1                 # 0 turns server-side voice-note transcription off (needs pip install -r requirements-extras.txt)
BAITPROOF_STT_MODEL=base        # faster-whisper model size: tiny | base | small (base is ~145 MB, downloaded once on first use)

# --- Logs ---
BAITPROOF_LOG_DIR=logs
BAITPROOF_LOG_SALT=             # random string; salts the message hashes in the logs

# --- Web Push: "a friend just passed you" notifications (optional; off until both keys are set). `python -m scripts.ops.make_vapid` fills them in .env ---
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=                  # mailto: or https: address you control
